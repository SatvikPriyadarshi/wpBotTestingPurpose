# WhatsApp Automated Messaging Bot Configuration
# Copy this file to .env and fill in your values

# Target phone number (with country code, no +)
# Example: 1234567890 for US number, 447911123456 for UK, 919876543210 for India
TARGET_NUMBER=YOUR_TARGET_PHONE_NUMBER

# Optional: Set timezone for message scheduling
# Default: Asia/Kolkata (IST)
# Examples: America/New_York, Europe/London, Asia/Kolkata
TIMEZONE=Asia/Kolkata

# Optional: Health check server port
# Default: 3000
PORT=3000
